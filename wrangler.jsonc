{
  // Cloudflare Worker config. One Worker serves the static site (public/) and the /api routes.
  "name": "pencilslop",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pencilslop",
      // Identifies the database within the account; not a credential.
      "database_id": "466ea874-fd90-42c6-8cea-446b0757f530"
    }
  ]
}
