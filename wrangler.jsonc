{
  // Cloudflare Worker config. One Worker serves the static site (public/) and the /api routes.
  "name": "pencilslop",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pencilslop",
      // Placeholder for local dev; replaced with the real ID after `wrangler d1 create`.
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
