{
  "name": "pencilslop",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:schema:local": "wrangler d1 execute pencilslop --local --file=db/schema.sql",
    "db:seed:local": "wrangler d1 execute pencilslop --local --file=db/seed.sql",
    "db:schema:remote": "wrangler d1 execute pencilslop --remote --file=db/schema.sql",
    "db:seed:remote": "wrangler d1 execute pencilslop --remote --file=db/seed.sql"
  },
  "devDependencies": {
    "wrangler": "^4.159.0"
  }
}
